{
  "version": "v1",
  "hooks": [
    {
      "name": "Token-only CSS on save",
      "description": "Runs stylelint on a saved CSS Module: no hex, rgb(), named colours or raw px; components consume var(--sr-*) role tokens only.",
      "trigger": "PostFileSave",
      "matcher": "\.module\.css$",
      "action": { "type": "command", "command": "node scripts/hooks/run-if-workspace.mjs pnpm exec stylelint" },
      "timeout": 60
    },
    {
      "name": "Lint TypeScript on save",
      "trigger": "PostFileSave",
      "matcher": "\.(ts|tsx)$",
      "action": { "type": "command", "command": "node scripts/hooks/run-if-workspace.mjs pnpm exec eslint --fix" },
      "timeout": 60
    },
    {
      "name": "400-line cap on save",
      "trigger": "PostFileSave",
      "matcher": "\.(ts|tsx|css)$",
      "action": { "type": "command", "command": "node scripts/hooks/line-cap.mjs" },
      "timeout": 30
    },
    {
      "name": "Gates before the agent stops",
      "description": "typecheck + lint + test; the result is appended to var/kiro-runs/gates.jsonl for the orchestrator.",
      "trigger": "Stop",
      "action": { "type": "command", "command": "node scripts/hooks/gates.mjs" },
      "timeout": 600
    }
  ]
}
