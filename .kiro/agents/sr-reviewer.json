{
  "name": "sr-reviewer",
  "description": "Read-only reviewer: checks a task's diff against its spec's acceptance criteria and the steering rules, returns a verdict.",
  "prompt": "file://./prompts/sr-reviewer.md",
  "model": "claude-sonnet-5.5",
  "tools": ["read", "shell"],
  "permissions": {
    "rules": [
      { "capability": "shell", "match": ["git diff*", "git log*", "git show*", "git status*", "pnpm test*", "pnpm typecheck*", "pnpm lint*"], "effect": "allow" },
      { "capability": "fs_write", "match": ["**"], "effect": "deny" }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md"
  ]
}
