# Server variables for the functions under api/ (m0-spine requirement 5.2).
# Set them in the Vercel project (Settings > Environment Variables). .env files are git-ignored.
# Every value is left empty on purpose. With nothing set, the server runs on the replay plane:
# recorded answers from assets/replay/**, no keys, no paid calls.
# None of these may carry a VITE_ prefix: they must never reach the client bundle.

# Plane: "live" turns on paid calls; empty or any other value means replay.
SR_PLANE=

# Global daily spend ceiling in US dollars, estimated per call; over it, paid endpoints answer
# with error code "quota" before calling out. Default when empty: 30.
SR_DAILY_USD_CAP=

# Google Gemini key: image generation, segmentation and TTS. Needed only on the live plane.
GEMINI_API_KEY=

# Anthropic key for the chat engine. On the live plane without it, /api/health reports the
# engine as "offline". /api/health only reports whether it is set, never its value.
ANTHROPIC_API_KEY=

# Model ids. Empty means the default named in each comment.
# Final image model. Default: gemini-3-pro-image
SR_IMAGE_MODEL=
# Draft image model, used before the final reveal. Default: gemini-3.1-flash-image
SR_IMAGE_DRAFT_MODEL=
# Segmentation model; answers with part polygons, not masks. Default: gemini-3.8-flash
SR_SEGMENT_MODEL=
# Text-to-speech model (Gemini TTS) for /api/voice. Default: gemini-3.8-flash-tts
SR_TTS_MODEL=
# Chat engine model (Anthropic Messages API). Default: claude-haiku-5-5
SR_ENGINE_MODEL=

# Per-IP daily limits for paid calls. Defaults when empty: forge 3, engine 60, voice 60.
SR_FORGE_PER_IP=
SR_ENGINE_PER_IP=
SR_VOICE_PER_IP=
# Salt for the HMAC that hides client IPs in quota keys. Empty: derived from KV_REST_API_TOKEN.
SR_QUOTA_SALT=

# Storage for the live plane (forge jobs, layer images, quota counters). A Vercel deploy on the
# live plane without them refuses paid calls ("quota"/"upstream"); replay never needs them.
# Upstash Redis (Vercel KV / Marketplace integration), REST API:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob store (forge uploads and generated layers, deleted after 24 h by the cron):
BLOB_READ_WRITE_TOKEN=

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to /api/cron/forge-gc (daily).
# Without it the sweep answers 401 and deletes nothing.
CRON_SECRET=

# Build setting, not read by the app: lets Vercel install the pnpm version pinned in
# package.json "packageManager" (pnpm 11) through corepack. Set it to 1 in the Vercel project.
ENABLE_EXPERIMENTAL_COREPACK=

# Set by Vercel itself, do not set by hand: VERCEL_ENV (production/preview: no in-memory fallback
# for jobs or quota), VERCEL_GIT_COMMIT_SHA (its first 7 characters are
# the "version" in /api/health; "dev" when absent).
